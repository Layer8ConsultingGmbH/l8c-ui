{
  "name": "shared-components",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build l8c-ui --configuration production",
    "build:dev": "ng build l8c-ui --configuration development",
    "watch": "ng build l8c-ui --watch --configuration development",
    "test": "ng test",
    "pack": "cd dist/l8c-ui && npm pack",
    "publish:local": "npm run build && npm run pack"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "22.1.1",
    "@angular/compiler": "22.1.1",
    "@angular/core": "22.1.1",
    "@angular/forms": "22.1.1",
    "@angular/platform-browser": "22.1.1",
    "@angular/router": "22.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.1.3",
    "@angular/cli": "22.1.3",
    "@angular/compiler-cli": "22.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^27.1.0",
    "ng-packagr": "^22.0.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
